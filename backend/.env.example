# ============================================================================
# 极简私人通讯 (Minimal Chat) — Staging / Production 环境变量模板
# ----------------------------------------------------------------------------
# 复制本文件为 .env 并填入真实值；.env 绝对禁止提交 Git。
# 所有 secret 必须由部署环境注入，禁止硬编码到源码 / Dockerfile / compose。
# ============================================================================

# --- 运行环境 ---
# development | testing | production
ENVIRONMENT=staging

# --- 数据库（PostgreSQL，业务库专用，禁止超级用户） ---
# 格式：postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# 示例：postgresql+psycopg://chat_staging_user:CHANGE_ME@127.0.0.1:5432/chat_staging
DATABASE_URL=postgresql+psycopg://chat_staging_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/chat_staging

# --- JWT（必须强随机，禁止留空；生产缺失将启动失败） ---
# 生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_OPENSSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS（环境变量驱动；明确来源，禁止 "*" 通配） ---
# 多个来源逗号分隔。Staging 用具体域名，不要为测试永久打开 wildcard。
CORS_ORIGINS=https://staging.example.com,https://staging.minimal-chat.example.com

# --- QR Login（基础设施已建表，流程在 Phase 6；此处仅参数，无流程） ---
QR_SESSION_TTL_SECONDS=90
QR_POLL_INTERVAL_SECONDS=3
